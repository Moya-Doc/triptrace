# 复制本文件为 .env.local，再填入你自己的 Key。.env.local 不会被提交进代码仓库。

# 大模型：任意 OpenAI 兼容接口，默认 DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 高德 Web 服务 Key（只在服务端使用）
AMAP_WEB_SERVICE_KEY=

# 高德 Web 端（JS API）Key 和安全密钥（会下发到浏览器，只适合本地演示）
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
